# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,backend,nginx
GUNICORN_LOG_LEVEL=info

# PostgreSQL 18
DB_NAME=shifoxona_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS (frontend domain qo'shing)
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:80,https://your-app.onrender.com

# Frontend
VITE_API_URL=/api/v1

